  "narrative": {
    "northStar": "The Village Chronicle, Open at Today’s Leaf",
    "overview": "Wendessen keeps one register, and the website is that register: a ruled margin with today’s date and tallies, numbered dated entries, and a stamp for every state. The shell is the binding — pine buckram with a foil rule — and the body is iron ink on cool bone paper with one rubric red that only ever means state. The system is flat, ruled and quiet; it refuses the illustrated hero, gradient bands, white cards and carousels of the village-portal default it replaced.",
    "keyCharacteristics": [
      "Pine buckram shell with a foil hairline, bone paper body",
      "One-pixel rules, zero radius, zero shadow",
      "A 168 px register margin that becomes a date strip on phones",
      "One rubric red reserved for state and attention",
      "Tabular numerals on a fixed integer ramp",
      "States as printed marks: open, new, decided, draft, pinned, cancelled"
    ],
    "rules": [
      {
        "name": "The One Red Rule",
        "body": "Rubric red marks state or attention, nothing else.",
        "section": "colors"
      },
      {
        "name": "The Paper Rule",
        "body": "No colour outside the tokens; a new hue means the direction drifted.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Any figure that can be compared is set in tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Two-Voice Rule",
        "body": "Literata never appears in a control, label, table or heading above 24 px.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "No shadow anywhere; depth comes from paper tones and one-pixel rules.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Let the margin carry live data: the date, the counts, the next entry.",
      "Keep a cancelled entry in place, struck through and stamped.",
      "Use one-pixel rules to separate and paper tones to group.",
      "Set every comparable number in tabular figures.",
      "Show loading, empty, error and success in the register’s own language."
    ],
    "donts": [
      "No radius, shadow, gradient, glass, icon tiles or emoji.",
      "No hue outside the tokens.",
      "No state signalled by colour alone.",
      "No thick coloured bar on the side of a card, row or notice.",
      "No list turned into cards, and no card inside a card.",
      "No entrance animations; motion is state feedback only."
    ]
  }
}